{
  "name": "repo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:dashboard": "pnpm --filter @repo/dashboard dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:web": "pnpm --filter @repo/web build",
    "build:dashboard": "pnpm --filter @repo/dashboard build",
    "build:admin": "pnpm --filter @repo/admin build",
    "build:api": "pnpm --filter @repo/api build",
    "type-check": "pnpm --recursive --no-sort type-check",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm type-check && pnpm lint && pnpm format:check",
    "check:i18n": "pnpm --filter @repo/i18n check:i18n",
    "db:dev:up": "bash scripts/start-dev-db.sh",
    "db:dev:down": "bash scripts/stop-dev-db.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "catalog:",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.2"
}
