{
  "name": "repo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:dashboard": "pnpm --filter @repo/dashboard dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:web": "pnpm --filter @repo/web build",
    "build:dashboard": "pnpm --filter @repo/dashboard build",
    "build:admin": "pnpm --filter @repo/admin build",
    "build:api": "pnpm --filter @repo/api build",
    "type-check": "pnpm --recursive type-check",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm type-check && pnpm lint && pnpm format:check",
    "check:i18n": "pnpm --filter @repo/i18n check:i18n",
    "db:dev:up": "bash scripts/start-dev-db.sh",
    "db:dev:down": "bash scripts/stop-dev-db.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "pnpm": {
    "packageExtensions": {
      "tsconfck@*": {
        "peerDependencies": {
          "typescript": ">=5.0.0"
        }
      }
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "tsconfck>typescript": "7.0.2",
        "react-i18next>typescript": "7.0.2",
        "typescript": "7.0.2"
      }
    }
  }
}
