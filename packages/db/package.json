{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/env": "./src/config/env.ts",
    "./config/env.server": "./src/config/env.server.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "pnpm -C ../.. exec vitest run packages/db/src",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed:development": "tsx src/seed/development/index.ts",
    "db:seed:production": "tsx src/seed/production/index.ts",
    "db:audit:legacy-orders": "tsx src/scripts/audit-legacy-orders.ts",
    "db:repair:owner-organizations": "tsx src/scripts/repair-owner-organizations.ts"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "@repo/validators": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "catalog:"
  }
}
