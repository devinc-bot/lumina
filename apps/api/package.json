{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx dist/main.js",
    "type-check": "tsc --noEmit",
    "test:health": "pnpm -C ../.. exec vitest run apps/api/src/modules/health/presentation/health.controller.test.ts",
    "test": "pnpm -C ../.. exec vitest run apps/api/src",
    "test:mail-templates": "node ../../node_modules/vitest/vitest.mjs run apps/api/src/modules/mail/templates/mail-templates.preview.test.ts apps/api/src/modules/mail/templates/mail-layout.polish.test.ts --root ../..",
    "mail:preview": "email dev --dir src/modules/mail/templates --port 3333",
    "mail:smoke": "node --env-file=.env --import tsx src/modules/mail/scripts/smoke-mail.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-sesv2": "3.1131.0",
    "@aws-sdk/s3-presigned-post": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.0",
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/validators": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "files-sdk": "2.4.1",
    "google-auth-library": "11.0.2",
    "mercadopago": "3.6.1",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@react-email/ui": "6.9.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
