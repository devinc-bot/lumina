{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".agents/**",
    ".worktrees/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "packages/db/src/migrations-postgresql/meta/**"
  ],
  "tabWidth": 2,
  "endOfLine": "lf",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "semi": false
}
