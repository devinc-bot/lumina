# API runtime configuration for the staging VPS. The direct migration URL belongs only in
# staging.migrator.env, not in this file.
DATABASE_URL=REPLACE_WITH_STAGING_NEON_POOLED_URL
PORT=3000
NODE_ENV=production

JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_STAGING_REFRESH_TOKEN_SECRET
API_PUBLIC_URL=https://api.staging.example.com
WEB_URL=https://staging.example.com
DASHBOARD_URL=https://dashboard.staging.example.com
ADMIN_URL=https://admin.staging.example.com
TRUST_PROXY_HOPS=1

# Optional in-process API rate limits. Omit a pair to use the schema default.
RATE_LIMIT_PUBLIC_LIMIT=120
RATE_LIMIT_PUBLIC_TTL_MS=60000
RATE_LIMIT_AUTHENTICATED_LIMIT=240
RATE_LIMIT_AUTHENTICATED_TTL_MS=60000
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_MS=900000
RATE_LIMIT_AUTH_SENSITIVE_LIMIT=5
RATE_LIMIT_AUTH_SENSITIVE_TTL_MS=900000
RATE_LIMIT_AUTH_CONFIRM_LIMIT=20
RATE_LIMIT_AUTH_CONFIRM_TTL_MS=900000
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_TTL_MS=60000
RATE_LIMIT_PURCHASE_LIMIT=10
RATE_LIMIT_PURCHASE_TTL_MS=60000
RATE_LIMIT_QR_LIMIT=20
RATE_LIMIT_QR_TTL_MS=60000
RATE_LIMIT_CHECK_IN_LIMIT=60
RATE_LIMIT_CHECK_IN_TTL_MS=60000
RATE_LIMIT_GEO_LIMIT=30
RATE_LIMIT_GEO_TTL_MS=60000

GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_GOOGLE_CLIENT_SECRET
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=REPLACE_WITH_STAGING_MAIL_FROM
MAIL_REPLY_TO=
MAIL_SMOKE_TO=REPLACE_WITH_STAGING_MAIL_SMOKE_TO

MERCADOPAGO_ACCESS_TOKEN=REPLACE_WITH_STAGING_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_STAGING_MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_TEST_MODE=true

R2_ACCOUNT_ID=REPLACE_WITH_STAGING_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_STAGING_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_STAGING_R2_BUCKET
R2_PUBLIC_BASE_URL=https://REPLACE_WITH_STAGING_R2_PUBLIC_HOST

# Cloud Run / internal jobs (feature 042). Staging uses NODE_ENV=production artifacts.
# Audience must exactly match Cloud Scheduler's OIDC audience and the GitHub
# Environment variable. It is independent from the Scheduler's native Cloud Run URI.
INTERNAL_JOBS_OIDC_AUDIENCE=https://api.staging.example.com
INTERNAL_JOBS_OIDC_ALLOWED_SERVICE_ACCOUNTS=lumina-scheduler-staging@REPLACE_WITH_GCP_PROJECT.iam.gserviceaccount.com
ENABLE_IN_PROCESS_SCHEDULERS=false
DATABASE_POOL_MAX=10
